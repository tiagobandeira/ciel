{
  "_comentario": "Copie este arquivo para ciel_config.json e preencha com suas credenciais.",

  "base_url":    "https://integrate.api.nvidia.com/v1",
  "model":       "deepseek-ai/deepseek-v4-flash-0731",
  "api_key":     "SUA_CHAVE_AQUI",
  "api_key_env": "SECONDARY_MODEL_API_KEY",

  "timeout":               120,
  "max_chars_per_session": 40000,
  "max_response_chars":    8000,
  "max_tokens": 16384,

  "_alternativas": {
    "openrouter": { "base_url": "https://openrouter.ai/api/v1",      "model": "qwen/qwen3-235b-a22b:free"                },
